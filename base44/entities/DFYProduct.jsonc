{
  "name": "DFYProduct",
  "type": "object",
  "properties": {
    "softwareName": {
      "type": "string",
      "description": "Software name / title"
    },
    "logo": {
      "type": "string",
      "description": "Logo image URL"
    },
    "thumbnail": {
      "type": "string",
      "description": "Product thumbnail/cover image URL shown in the import grid"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Gallery of product feature images shown on the storefront product page after import"
    },
    "demoVideoUrl": {
      "type": "string",
      "description": "Demo video URL (mp4 or YouTube link) previewed in the import grid"
    },
    "shortDescription": {
      "type": "string",
      "description": "Short description / tagline"
    },
    "fullDescription": {
      "type": "string",
      "description": "Full detailed description"
    },
    "category": {
      "type": "string",
      "description": "Category name (e.g. CRM, AI & ML)"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of key features"
    },
    "pricingType": {
      "type": "string",
      "enum": [
        "free",
        "paid",
        "subscription",
        "lifetime_deal",
        "custom_quote"
      ],
      "default": "lifetime_deal",
      "description": "Pricing model"
    },
    "price": {
      "type": "number",
      "description": "Full price"
    },
    "discountPrice": {
      "type": "number",
      "description": "Discounted deal price"
    },
    "dealType": {
      "type": "string",
      "enum": [
        "group_deal",
        "single_purchase",
        "both"
      ],
      "default": "single_purchase",
      "description": "Deal offering type"
    },
    "sharePrice": {
      "type": "number",
      "description": "Price per individual spot/share"
    },
    "totalShares": {
      "type": "number",
      "description": "Total number of spots/shares"
    },
    "monthlyRevenue": {
      "type": "number",
      "description": "Monthly revenue in dollars"
    },
    "growthRate": {
      "type": "number",
      "default": 0,
      "description": "Growth rate percentage"
    },
    "rating": {
      "type": "number",
      "default": 5,
      "description": "Rating out of 5"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of tags"
    },
    "imageGradient": {
      "type": "string",
      "description": "CSS gradient for card header"
    },
    "adminAccessType": {
      "type": "string",
      "enum": [
        "none",
        "url",
        "info"
      ],
      "default": "none",
      "description": "How admin access is delivered to store owners who import this product: 'url' opens a link in a new tab, 'info' reveals text instructions inline, 'none' hides the Get Admin Access button"
    },
    "adminAccessUrl": {
      "type": "string",
      "description": "Admin access URL opened in a new tab when adminAccessType is 'url'"
    },
    "adminAccessInfo": {
      "type": "string",
      "description": "Admin access instructions/credentials revealed inline when adminAccessType is 'info'"
    },
    "adminDemoVideoUrl": {
      "type": "string",
      "description": "Demo video (mp4 or YouTube link) shown only to the store owner in the Get Admin Access panel, explaining how to create/manage user access on the underlying software"
    },
    "provisionEndpointUrl": {
      "type": "string",
      "description": "Optional per-product provisioning endpoint URL. When set, clicking 'Get Admin Access' POSTs the store owner's name & email to this URL (signed with the universal PLATFORM_WEBHOOK_SECRET) so the external app can grant access on demand."
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Whether this DFY preset is available for import"
    }
  },
  "required": [
    "softwareName"
  ]
}