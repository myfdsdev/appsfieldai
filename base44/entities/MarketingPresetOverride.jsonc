{
  "name": "MarketingPresetOverride",
  "type": "object",
  "properties": {
    "presetId": {
      "type": "string",
      "description": "The Marketing Studio preset id this record customizes. For built-in presets this matches the built-in id; for admin-created custom presets it is a generated unique id."
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "description": "Which studio tab this preset belongs to"
    },
    "isCustom": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a fully admin-created custom preset (true) or an override of a built-in preset (false)"
    },
    "emoji": {
      "type": "string",
      "description": "Emoji shown as the fallback icon for custom presets when no thumbnail is set"
    },
    "label": {
      "type": "string",
      "description": "Custom title/label shown on the template card (overrides the built-in)"
    },
    "prompt": {
      "type": "string",
      "description": "Custom base prompt / design direction (overrides the built-in)"
    },
    "thumbnailUrl": {
      "type": "string",
      "description": "Custom thumbnail image URL (overrides the auto-generated one)"
    }
  },
  "required": [
    "presetId",
    "mediaType"
  ]
}