{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "user",
        "marketplace_owner"
      ],
      "default": "user",
      "description": "User role"
    },
    "requireListingApproval": {
      "type": "boolean",
      "default": true,
      "description": "Whether new SaaS listings require admin approval"
    },
    "walletBalance": {
      "type": "number",
      "default": 0,
      "description": "User's wallet balance"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "avatarUrl": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "businessName": {
      "type": "string",
      "description": "Business name (for marketplace owners)"
    },
    "billingStatus": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "cancelled",
        "trial"
      ],
      "default": "trial",
      "description": "Subscription billing status"
    },
    "planId": {
      "type": "string",
      "description": "Active SubscriptionPlan ID"
    },
    "jvzooPlanIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of SubscriptionPlan IDs assigned via JVZoo purchases"
    },
    "marketplaceCount": {
      "type": "number",
      "default": 0,
      "description": "Number of marketplaces owned"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "suspended",
        "cancelled"
      ],
      "default": "active",
      "description": "Account status"
    },
    "telegramChatId": {
      "type": "string",
      "description": "Connected Telegram chat ID that receives agent alerts (new leads, new sales). Set automatically when the owner starts the Telegram bot."
    },
    "telegramUsername": {
      "type": "string",
      "description": "Telegram @username of the connected account (for display)"
    },
    "telegramConnectCode": {
      "type": "string",
      "description": "One-time code embedded in the bot deep link, used to match the owner when they start the bot"
    },
    "marketingApiKeys": {
      "type": "object",
      "description": "Store owner's own AI provider API keys for Marketing Studio image/video generation. When a key is set, generation uses it and is unlimited (the plan's monthly caps only apply to the shared platform key).",
      "properties": {
        "kieAiApiKey": {
          "type": "string",
          "description": "Owner's own Kie.ai API key used for image & video generation"
        }
      }
    },
    "marketingUsage": {
      "type": "object",
      "description": "Monthly Marketing Studio generation counters against the shared platform key. Reset automatically when the month changes.",
      "properties": {
        "periodMonth": {
          "type": "string",
          "description": "The month these counters apply to, in YYYY-MM format"
        },
        "imageCount": {
          "type": "number",
          "default": 0,
          "description": "Images generated this month on the shared platform key"
        },
        "videoCount": {
          "type": "number",
          "default": 0,
          "description": "Videos generated this month on the shared platform key"
        }
      }
    },
    "leadFinderSmtp": {
      "type": "object",
      "description": "Personal SMTP settings used to send Lead Finder outreach emails",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "host": {
          "type": "string",
          "description": "SMTP server host"
        },
        "port": {
          "type": "number",
          "default": 587,
          "description": "SMTP server port"
        },
        "username": {
          "type": "string",
          "description": "SMTP username"
        },
        "password": {
          "type": "string",
          "description": "SMTP password"
        },
        "secure": {
          "type": "boolean",
          "default": false,
          "description": "Use SSL (port 465)"
        },
        "fromName": {
          "type": "string",
          "description": "Sender display name"
        },
        "fromEmail": {
          "type": "string",
          "description": "Sender email address"
        }
      }
    }
  }
}