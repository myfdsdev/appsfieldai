{
  "name": "Marketplace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Marketplace name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly unique slug"
    },
    "ownerId": {
      "type": "string",
      "description": "User ID of the marketplace owner"
    },
    "type": {
      "type": "string",
      "enum": [
        "single_vendor",
        "multi_vendor",
        "workspace"
      ],
      "default": "single_vendor",
      "description": "Marketplace type. single_vendor = you sell your own products. multi_vendor = other sellers can list. workspace = a service-offering store."
    },
    "description": {
      "type": "string",
      "description": "Owner's description of what the marketplace is about"
    },
    "template": {
      "type": "string",
      "enum": [
        "default",
        "minimal",
        "bold",
        "enterprise"
      ],
      "default": "default",
      "description": "Chosen design template"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product categories for this marketplace"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code (e.g. USD, INR, EUR)"
    },
    "language": {
      "type": "string",
      "default": "English",
      "description": "Store language"
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "description": "Timezone (e.g. Asia/Calcutta)"
    },
    "supportEmail": {
      "type": "string",
      "description": "Support contact email"
    },
    "storeLink": {
      "type": "string",
      "description": "Public store URL"
    },
    "subdomain": {
      "type": "string",
      "description": "Platform subdomain (e.g. mystore)"
    },
    "customDomain": {
      "type": "string",
      "description": "Custom domain URL (e.g. deals.clientbrand.com)"
    },
    "verificationToken": {
      "type": "string",
      "description": "Unique token for DNS TXT verification"
    },
    "verificationStatus": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "verified",
        "failed"
      ],
      "default": "pending"
    },
    "sslStatus": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "failed"
      ],
      "default": "pending"
    },
    "dnsInstructions": {
      "type": "string"
    },
    "connectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "suspended"
      ],
      "default": "draft"
    },
    "planId": {
      "type": "string",
      "description": "Linked SubscriptionPlan ID"
    },
    "branding": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "description": "Store logo (light mode)"
        },
        "logoDark": {
          "type": "string",
          "description": "Store logo shown in dark mode"
        },
        "favicon": {
          "type": "string"
        },
        "primaryColor": {
          "type": "string",
          "default": "#7c3aed"
        },
        "accentColor": {
          "type": "string",
          "default": "#06b6d4"
        }
      }
    },
    "payment": {
      "type": "object",
      "description": "Store payment gateway configuration",
      "properties": {
        "paypalEnabled": {
          "type": "boolean",
          "default": false
        },
        "paypalMode": {
          "type": "string",
          "enum": [
            "sandbox",
            "live"
          ],
          "default": "sandbox"
        },
        "paypalClientId": {
          "type": "string"
        },
        "paypalSecret": {
          "type": "string"
        },
        "paypalEmail": {
          "type": "string"
        },
        "stripeEnabled": {
          "type": "boolean",
          "default": false
        },
        "stripeSecretKey": {
          "type": "string"
        },
        "stripePublishableKey": {
          "type": "string"
        },
        "razorpayEnabled": {
          "type": "boolean",
          "default": false
        },
        "razorpayKeyId": {
          "type": "string"
        },
        "razorpayKeySecret": {
          "type": "string"
        },
        "codEnabled": {
          "type": "boolean",
          "default": false
        },
        "codInstructions": {
          "type": "string"
        }
      }
    },
    "emailSettings": {
      "type": "object",
      "description": "Store SMTP and transactional email configuration",
      "properties": {
        "smtpEnabled": {
          "type": "boolean",
          "default": false
        },
        "smtpHost": {
          "type": "string"
        },
        "smtpPort": {
          "type": "number",
          "default": 587
        },
        "smtpUsername": {
          "type": "string"
        },
        "smtpPassword": {
          "type": "string"
        },
        "smtpSecure": {
          "type": "boolean",
          "default": true
        },
        "fromName": {
          "type": "string"
        },
        "fromEmail": {
          "type": "string"
        },
        "templates": {
          "type": "object",
          "description": "Transactional email templates keyed by action",
          "additionalProperties": true,
          "properties": {
            "welcome": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "subject": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            },
            "orderConfirmation": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "subject": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            },
            "reservation": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "subject": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "pageSections": {
      "type": "object",
      "description": "Page section visibility settings",
      "additionalProperties": true,
      "properties": {
        "storeStyle": {
          "type": "string",
          "description": "Selected full visual store style slug"
        },
        "productsSectionSubtitle": {
          "type": "string"
        },
        "plansEnabled": {
          "type": "boolean",
          "default": false
        },
        "plansTitle": {
          "type": "string"
        },
        "plansSubtitle": {
          "type": "string"
        },
        "dealMakerVoice": {
          "type": "string"
        },
        "dealMakerEnabled": {
          "type": "boolean",
          "default": true
        },
        "dealMakerName": {
          "type": "string"
        },
        "dealMakerImageUrl": {
          "type": "string"
        },
        "dealMakerTagline": {
          "type": "string"
        },
        "dealMakerLayout": {
          "type": "string",
          "enum": [
            "centered",
            "avatar_left",
            "avatar_right",
            "spotlight"
          ],
          "default": "centered"
        },
        "dealMakerBgOpacity": {
          "type": "number",
          "default": 5
        },
        "dealMakerBgTheme": {
          "type": "string",
          "enum": [
            "midnight",
            "aurora",
            "sunset",
            "violet",
            "emerald",
            "mono"
          ],
          "default": "midnight"
        },
        "dealMakerOwnerName": {
          "type": "string"
        },
        "dealMakerNiche": {
          "type": "string"
        },
        "dealMakerGuarantee": {
          "type": "string"
        },
        "dealMakerGreeting": {
          "type": "string"
        },
        "dealMakerKnowledge": {
          "type": "string"
        },
        "headerEnabled": {
          "type": "boolean",
          "default": true
        },
        "headerTextEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether the hero headline, subtitle and badge text are shown"
        },
        "dealsEndingSoonEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether the Exclusive Deals countdown slider is shown"
        },
        "headerTitle": {
          "type": "string"
        },
        "headerSubtitle": {
          "type": "string"
        },
        "headerImageUrl": {
          "type": "string"
        },
        "headerLogoUrl": {
          "type": "string"
        },
        "heroSideImageUrl": {
          "type": "string"
        },
        "heroSideImagePosition": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "right"
        },
        "heroBadgeText": {
          "type": "string"
        },
        "heroCtaText": {
          "type": "string"
        },
        "heroSecondaryCtaText": {
          "type": "string"
        },
        "heroBgType": {
          "type": "string",
          "enum": [
            "gradient",
            "solid",
            "image"
          ],
          "default": "gradient"
        },
        "heroGradientStart": {
          "type": "string"
        },
        "heroGradientEnd": {
          "type": "string"
        },
        "heroSolidColor": {
          "type": "string"
        },
        "heroBgOpacity": {
          "type": "number",
          "default": 100
        },
        "productsEnabled": {
          "type": "boolean",
          "default": true
        },
        "productsSectionTitle": {
          "type": "string"
        },
        "testimonialsEnabled": {
          "type": "boolean",
          "default": false
        },
        "testimonialsTitle": {
          "type": "string"
        },
        "trustBadgesEnabled": {
          "type": "boolean",
          "default": false
        },
        "trustBadgesTitle": {
          "type": "string"
        },
        "trustBadges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": {
                "type": "string"
              },
              "imageUrl": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "link": {
                "type": "string"
              }
            }
          }
        },
        "faqEnabled": {
          "type": "boolean",
          "default": false
        },
        "faqTitle": {
          "type": "string"
        },
        "faqs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              }
            }
          }
        },
        "customBoxesEnabled": {
          "type": "boolean",
          "default": false
        },
        "customBoxes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "customBannerEnabled": {
          "type": "boolean",
          "default": false
        },
        "customBannerImageUrl": {
          "type": "string"
        },
        "customBannerTitle": {
          "type": "string"
        },
        "customBannerSubtitle": {
          "type": "string"
        },
        "customBannerTextPosition": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ],
          "default": "center"
        },
        "footerEnabled": {
          "type": "boolean",
          "default": true
        },
        "footerText": {
          "type": "string"
        },
        "footerCopyright": {
          "type": "string"
        },
        "footerLogoUrl": {
          "type": "string"
        },
        "socialLinks": {
          "type": "object",
          "properties": {
            "facebook": {
              "type": "string"
            },
            "instagram": {
              "type": "string"
            },
            "twitter": {
              "type": "string"
            },
            "linkedin": {
              "type": "string"
            },
            "youtube": {
              "type": "string"
            },
            "tiktok": {
              "type": "string"
            }
          }
        },
        "customCodeHead": {
          "type": "string"
        },
        "customCodeBody": {
          "type": "string"
        }
      }
    },
    "taxInfo": {
      "type": "object",
      "description": "Tax configuration",
      "properties": {
        "taxEnabled": {
          "type": "boolean",
          "default": false
        },
        "taxName": {
          "type": "string"
        },
        "taxRate": {
          "type": "number",
          "default": 0
        },
        "taxNumber": {
          "type": "string"
        },
        "taxCountry": {
          "type": "string"
        },
        "includeTaxInPrice": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "requireListingApproval": {
          "type": "boolean",
          "default": true
        },
        "requireVendorApproval": {
          "type": "boolean",
          "default": true
        },
        "requireSoftwareApproval": {
          "type": "boolean",
          "default": true
        },
        "requireReviewApproval": {
          "type": "boolean",
          "default": false
        },
        "allowAuctions": {
          "type": "boolean",
          "default": false
        },
        "allowBidding": {
          "type": "boolean",
          "default": true
        },
        "commissionRate": {
          "type": "number",
          "default": 0
        },
        "termsPage": {
          "type": "string"
        },
        "privacyPage": {
          "type": "string"
        },
        "refundPolicy": {
          "type": "string"
        },
        "homepageSections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seoTitle": {
          "type": "string"
        },
        "seoDescription": {
          "type": "string"
        }
      }
    },
    "affiliateSettings": {
      "type": "object",
      "description": "Affiliate program configuration for this store",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "defaultCommissionRate": {
          "type": "number",
          "default": 30
        },
        "minCommissionRate": {
          "type": "number",
          "default": 10
        },
        "maxCommissionRate": {
          "type": "number",
          "default": 50
        },
        "holdDays": {
          "type": "number",
          "default": 14
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terms": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "name",
    "slug",
    "ownerId"
  ]
}