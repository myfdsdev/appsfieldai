{
  "name": "Activate Store Subscription On Payment",
  "description": "Keeps StoreSubscription records in sync when the linked StoreOrder's payment status changes (paid \u2192 active, refunded \u2192 expired).",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"paymentStatus\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "StoreOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "activate_store_subscription_on_payment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "activateStoreSubscription",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "activateStoreSubscription"
  }
}